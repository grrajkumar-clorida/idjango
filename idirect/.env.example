# Single env file for Django + docker compose.
# Path: idirect/.env  (VPS: /srv/idjango/idirect/.env)
# Root .env is a symlink to this file so `docker compose` can interpolate.

# Set DEBUG=True temporarily to see full HTML error pages in the browser.
# Keep False in production; use: docker logs -f idjango
DEBUG=False
SECRET_KEY=REPLACE_WITH_DJANGO_SECRET_KEY
ALLOWED_HOSTS=idjango.rbynex.in,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://idjango.rbynex.in

# App listen port INSIDE the container only (not bound on the VPS host).
# NPM Proxy Host must match:
#   idjango.rbynex.in -> http://idjango:8008
APP_PORT=8008

# MySQL
DATABASE_NAME=idirect
DATABASE_USER=idirect_app
DATABASE_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD
DATABASE_HOST=idjango-mysql
DATABASE_PORT=3306
DATABASE_USE_SOCKET=False

# Redis
REDIS_HOST=idjango-redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://idjango-redis:6379/0
CELERY_RESULT_BACKEND=redis://idjango-redis:6379/1

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Trading / integrations
# IMPORTANT: quote values — Breeze keys often contain # or ( which break unquoted .env lines.
# Example:
# BREEZE_API_KEY="7(#your_api_key_here"
# BREEZE_SECRET_KEY="your_secret_here"
BREEZE_API_KEY=
BREEZE_SECRET_KEY=
# Optional fallback only. Prefer ICICI redirect ?apisession= → AppSettings/Redis.
BREEZE_SESSION=
GSHEET_KEY=
GSHEET_ID=
GSHEET_APP_SCRIPT=
GSHEET_APP_SCRIPT_CMP=
SMA_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Halfbat listener (scraping.py) — never commit real values
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

PAPER_TRADING_MODE=True
TRADING_ENABLED=False
MAX_POSITION_SIZE=100000
MAX_PORTFOLIO_EXPOSURE=50.0
MAX_DAILY_LOSS=5000
MAX_DRAWDOWN=10.0
